{
  "name": "@cyberluke/railgun",
  "version": "2.0.1",
  "description": "Node launcher + workspace migrator for the railgun.exe native toolchain: one-pass type-aware lint/typecheck via Oxlint and tsgolint.",
  "type": "commonjs",
  "bin": {
    "railgun": "bin/railgun.js",
    "railgunize": "bin/railgun.js"
  },
  "files": [
    "bin/railgun.js",
    "skills/SKILL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@cyberluke/railgun-win32-x64": "2.0.1",
    "@cyberluke/railgun-linux-x64": "2.0.1",
    "@cyberluke/railgun-linux-arm64": "2.0.1",
    "@cyberluke/railgun-darwin-arm64": "2.0.1"
  },
  "keywords": [
    "typescript",
    "nextjs",
    "pnpm",
    "turborepo",
    "lint",
    "typecheck",
    "agents"
  ]
}
